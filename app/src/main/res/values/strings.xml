    <!-- Onboarding -->
    <string name="ob_tagline">Intermittent fasting, made warm and simple</string>
    <string name="ob_f1_title">A timer that explains</string>
    <string name="ob_f1_text">See what your body is doing at every hour of a fast.</string>
    <string name="ob_f2_title">Streaks, levels and badges</string>
    <string name="ob_f2_text">Weekly challenges keep it fun, not a chore.</string>
    <string name="ob_f3_title">Learn as you go</string>
    <string name="ob_f3_text">Short, honest reads and a Hunger SOS for hard moments.</string>
    <string name="ob_f4_title">Free and private</string>
    <string name="ob_f4_text">No account, no ads, no subscription. Your data stays on the phone.</string>
    <string name="ob_begin">Let’s begin</string>
    <string name="ob_safety_title">Fasting isn’t for everyone</string>
    <string name="ob_safety_text">Please talk to a doctor first if any of these apply to you:</string>
    <string name="ob_safety_1">You are pregnant, breastfeeding or under 18</string>
    <string name="ob_safety_2">You have had an eating disorder</string>
    <string name="ob_safety_3">You have diabetes or take insulin or blood sugar medication</string>
    <string name="ob_safety_4">You take medication that must be taken with food</string>
    <string name="ob_safety_5">You are underweight or have a chronic condition</string>
    <string name="ob_safety_stop">Stop a fast whenever you feel faint, very weak or unwell. Ember is a companion, not medical advice.</string>
