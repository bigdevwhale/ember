    <!-- Plans -->
    <string name="plans">Fasting plan</string>
    <string name="plans_daily">Every day</string>
    <string name="plans_long">Longer fasts</string>
    <string name="plans_long_warning">For experienced fasters in good health. Drink water with a pinch of salt, and stop if you feel unwell.</string>
    <string name="plan_applies_now">The new goal also applies to the fast in progress.</string>
    <string name="plan_12_12">Gentle start</string>
    <string name="plan_12_12_text">Twelve hours overnight. The easiest way in: mostly while you sleep.</string>
    <string name="plan_14_10">Easy rhythm</string>
    <string name="plan_14_10_text">A slightly earlier dinner and a later breakfast. A great first plan.</string>
    <string name="plan_16_8">Leangains classic</string>
    <string name="plan_16_8_text">The most popular plan: skip breakfast or dinner, eat within eight hours.</string>
    <string name="plan_18_6">Focused</string>
    <string name="plan_18_6_text">Two meals in six hours. Deeper into fat burning every day.</string>
    <string name="plan_20_4">Warrior</string>
    <string name="plan_20_4_text">One big meal and a snack within four hours.</string>
    <string name="plan_omad">One meal a day</string>
    <string name="plan_omad_text">A single, satisfying meal. For those who already fast with ease.</string>
    <string name="plan_24h">Full day</string>
    <string name="plan_24h_text">Dinner to dinner, once or twice a week.</string>
    <string name="plan_36h">Monk fast</string>
    <string name="plan_36h_text">A full day and two nights. Now and then, not every week.</string>
    <string name="plan_48h">Two-day fast</string>
    <string name="plan_48h_text">Deep and demanding. Plan a calm couple of days for it.</string>
    <string name="plan_72h">Three-day fast</string>
    <string name="plan_72h_text">A rare reset for experienced fasters. Best with a doctor’s okay.</string>
